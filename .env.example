# Community Parking System - Environment Configuration
SECRET_KEY=cps-secret-key-change-in-production-2026

# Database Configuration (MySQL by default; falls back to local SQLite if MySQL is unreachable)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/community_parking_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=community_parking_db
MYSQL_USER=root
MYSQL_PASSWORD=password

# Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216
